# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Downloaded by the wrapper on first run, see https://maven.apache.org/tools/wrapper/
.mvn/wrapper/maven-wrapper.jar

# Gradle (in case the build moves off Maven)
.gradle/
build/
!src/**/build/
!gradle/wrapper/gradle-wrapper.jar

# Quarkus
# CLI registry/plugin cache written by the `quarkus` CLI
.quarkus/
# Local-only config overrides, never commit
.env
*.env.local

# Java
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
*.log
# IBM MQ JMS client log + lock, written to the working directory
mqjms.log*

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.project
.classpath
.settings/
.factorypath
bin/

# VS Code
.vscode/

# NetBeans
nbproject/private/
nbbuild/
nbdist/

# Claude Code: personal settings (shared .claude/settings.json is committed)
.claude/settings.local.json

# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.bak
